{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "eleventy.config.ts",
    "eslint.config.ts",
    "prettier.config.ts",
    "src/**/*.ts",
    "types/**/*.d.ts"
  ]
}
